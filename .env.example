# StorePilot configuration.
#
# Copy to .env and fill in what you have. Each store activates independently:
# set only the Google Play block and the App Store tools are simply not
# registered, and vice versa. Cross-store tools register when either store is on.
#
# Every variable below is read by the code. Run `setup_doctor` after editing.

# --- Google Play -------------------------------------------------------------
# Path to the service account JSON key. Setting this enables the Play adapter.
STOREPILOT_GOOGLE_CREDENTIALS=/absolute/path/to/service-account.json

# Bucket holding the Play report CSVs — the ONLY source of installs, ratings and
# earnings, because no Play REST API serves them. Play Console -> Download
# reports -> Statistics -> "Copy Cloud Storage URI". The gs:// prefix is
# optional; the id is 'pubsite_prod_rev_<n>' on older accounts and
# 'pubsite_prod_<accountId>' on newer ones.
#
# Access is an ACCOUNT-level Play Console permission, not a Cloud IAM role: in
# Play Console -> Users and permissions -> <service account> -> Account
# permissions, tick 'View app information and download bulk reports (read-only)',
# plus 'View financial data' for earnings. Per-app grants do not reach the bucket.
STOREPILOT_GOOGLE_REPORTS_BUCKET=pubsite_prod_rev_0123456789

# --- App Store Connect -------------------------------------------------------
# All three are required together; the adapter stays off until they are all set.
STOREPILOT_ASC_KEY_PATH=/absolute/path/to/AuthKey_XXXXXXXXXX.p8
STOREPILOT_ASC_KEY_ID=XXXXXXXXXX
STOREPILOT_ASC_ISSUER_ID=00000000-0000-0000-0000-000000000000

# Required by asc_get_sales only. App Store Connect -> Payments and Financial
# Reports; an 8-digit number next to your team name. Not the Team ID.
STOREPILOT_ASC_VENDOR_NUMBER=80000000

# --- Report cache ------------------------------------------------------------
# Past months are immutable, so their reports are cached forever; the current
# month gets a short TTL. This matters most for Apple's salesReports endpoint,
# which is rate limited far harder than the rest of its API.
# Default: ~/.storepilot/cache
#STOREPILOT_CACHE_DIR=~/.storepilot/cache
# Set to false to bypass the cache entirely (every call re-downloads).
#STOREPILOT_CACHE_ENABLED=true

# --- State, audit and write policy -------------------------------------------
# Directory holding the guard HMAC key, the single-use token ledger, the audit
# log and apps.toml. Point it somewhere per-project to sandbox an install.
# Default: ~/.storepilot
#STOREPILOT_STATE_DIR=~/.storepilot

# Append-only record of every write attempted: previewed, confirmed, rejected,
# executed, failed. No credentials are written to it.
# Default: <state dir>/audit.log
#STOREPILOT_AUDIT_LOG=~/.storepilot/audit.log

# Ceiling on the first production rollout step, as a fraction. Clamped to the
# range 0.01-0.5, so this can be tightened but never disabled. Widening past it
# always requires a separate, explicitly named play_expand_rollout call.
# Default: 0.2
#STOREPILOT_MAX_INITIAL_ROLLOUT=0.2

# The Play <-> App Store pairing registry. No store API states that a package
# name and an Apple ID are the same product, so the mapping lives in this file.
# Default: <state dir>/apps.toml
#STOREPILOT_APPS_FILE=~/.storepilot/apps.toml
